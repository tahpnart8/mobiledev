<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Đăng ký nhân viên"
            android:textColor="@color/primary"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="18dp"
            android:text="Nhập thông tin rồi bấm Register"
            android:textColor="@color/textLabel"
            android:textSize="14sp" />

        <!-- khung form -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_bg"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="82dp"
                    android:layout_height="wrap_content"
                    android:text="Họ và tên"
                    android:textColor="@color/textLabel"
                    android:textSize="16sp" />

                <EditText
                    android:id="@+id/edtName"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:background="@drawable/field_bg"
                    android:hint="Nguyễn Văn A"
                    android:inputType="textPersonName"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textColor="@color/textDark"
                    android:textColorHint="#94A3B8"
                    android:textSize="16sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="82dp"
                    android:layout_height="wrap_content"
                    android:text="Ngày sinh"
                    android:textColor="@color/textLabel"
                    android:textSize="16sp" />

                <EditText
                    android:id="@+id/edtDob"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:background="@drawable/field_bg"
                    android:digits="0123456789/"
                    android:hint="dd/MM/yyyy"
                    android:inputType="number"
                    android:maxLength="10"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textColor="@color/textDark"
                    android:textColorHint="#94A3B8"
                    android:textSize="16sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="82dp"
                    android:layout_height="wrap_content"
                    android:text="Giới tính"
                    android:textColor="@color/textLabel"
                    android:textSize="16sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:background="@drawable/field_bg"
                    android:gravity="center_vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp">

                    <Switch
                        android:id="@+id/swGender"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="Nam"
                        android:textColor="@color/textDark"
                        android:textSize="16sp"
                        android:thumbTint="@color/primary"
                        android:trackTint="#B6CCC9" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="82dp"
                    android:layout_height="wrap_content"
                    android:text="Sở thích"
                    android:textColor="@color/textLabel"
                    android:textSize="16sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:background="@drawable/field_bg"
                    android:gravity="center_vertical"
                    android:paddingStart="10dp"
                    android:paddingEnd="14dp">

                    <Spinner
                        android:id="@+id/spHobby"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@null"
                        android:entries="@array/hobby_array" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="▾"
                        android:textColor="@color/primary"
                        android:textSize="18sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="82dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Trình độ Tiếng Anh"
                    android:textColor="@color/textLabel"
                    android:textSize="16sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <CheckBox
                        android:id="@+id/cbHigh"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:buttonTint="@color/primary"
                        android:text="High"
                        android:textColor="@color/textDark"
                        android:textSize="16sp" />

                    <CheckBox
                        android:id="@+id/cbMedium"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:buttonTint="@color/primary"
                        android:text="Medium"
                        android:textColor="@color/textDark"
                        android:textSize="16sp" />

                    <CheckBox
                        android:id="@+id/cbLow"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:buttonTint="@color/primary"
                        android:text="Low"
                        android:textColor="@color/textDark"
                        android:textSize="16sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- day khoi nut xuong day man hinh -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="20dp" />

        <!-- 3 nut chuc nang -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <Button
                android:id="@+id/btnRegister"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:background="@drawable/btn_primary"
                android:backgroundTint="@color/primary"
                android:text="Register"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnCancel"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:background="@drawable/btn_gray"
                android:backgroundTint="@color/btnGray"
                android:text="Cancel"
                android:textAllCaps="false"
                android:textColor="@color/textDark"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnShow"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:background="@drawable/btn_primary"
                android:backgroundTint="@color/primary"
                android:text="Show"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
